meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username_or_email": "admin",
    "password": "admin123"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setEnvVar('jwtToken', res.body.token);
  }
}
