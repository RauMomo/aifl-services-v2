    "company": "PT Nusantara Synergy",
    "subject": "Diskusi Digitalisasi Operasional",
    "message": "Kami ingin berkonsultasi mengenai pengembangan aplikasi kustom dan otomatisasi alur kerja tim kami."
  }
}
